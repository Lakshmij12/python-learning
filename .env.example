# =============================================================================
# WhatsApp AI Assistant — environment configuration EXAMPLE
# -----------------------------------------------------------------------------
# Copy to `.env` and fill in real values. NEVER commit your real `.env`.
# Generate strong secrets with:  python scripts/generate_keys.py
# =============================================================================

# --- Application -------------------------------------------------------------
APP_NAME="WhatsApp AI Assistant"
APP_ENVIRONMENT=local          # local | development | staging | production
APP_DEBUG=false
APP_LOG_LEVEL=INFO             # DEBUG | INFO | WARNING | ERROR | CRITICAL
APP_HOST=0.0.0.0
APP_PORT=8000
APP_BASE_URL=http://localhost:8000
APP_CORS_ORIGINS=http://localhost:3000

# --- Database (PostgreSQL + pgvector) ---------------------------------------
DB_HOST=localhost
DB_PORT=5432
DB_USER=assistant
DB_PASSWORD=assistant
DB_NAME=assistant
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_ECHO=false

# --- Redis -------------------------------------------------------------------
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
# REDIS_PASSWORD=

# --- Security ----------------------------------------------------------------
# Required (strong, random) outside `local`.
SECURITY_JWT_SECRET=change-me-in-production
SECURITY_JWT_ALGORITHM=HS256
SECURITY_ACCESS_TOKEN_TTL_MINUTES=30
SECURITY_REFRESH_TOKEN_TTL_DAYS=14
# base64-encoded 32-byte key for AES-256-GCM (python scripts/generate_keys.py)
SECURITY_ENCRYPTION_KEY=
SECURITY_RATE_LIMIT_REQUESTS=60
SECURITY_RATE_LIMIT_WINDOW_SECONDS=60
SECURITY_WEBHOOK_REPLAY_WINDOW_SECONDS=300

# --- WhatsApp (official Cloud API / Meta Business Platform) ------------------
WHATSAPP_API_VERSION=v20.0
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
# Only messages from your own number are processed (privacy).
WHATSAPP_OWNER_PHONE_NUMBER=

# --- LLM router --------------------------------------------------------------
LLM_DEFAULT_PROVIDER=openai        # openai | gemini | claude | ollama
LLM_FALLBACK_PROVIDERS=ollama      # comma-separated ordered fallbacks
LLM_REQUEST_TIMEOUT_SECONDS=60
LLM_MAX_RETRIES=2
LLM_TEMPERATURE=0.3
LLM_EMBEDDING_DIMENSIONS=1536      # must match your embedding model

# --- OpenAI ------------------------------------------------------------------
# OPENAI_API_KEY=
OPENAI_CHAT_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
# OPENAI_BASE_URL=

# --- Gemini ------------------------------------------------------------------
# GEMINI_API_KEY=
GEMINI_CHAT_MODEL=gemini-1.5-flash
GEMINI_EMBEDDING_MODEL=text-embedding-004

# --- Claude ------------------------------------------------------------------
# CLAUDE_API_KEY=
CLAUDE_CHAT_MODEL=claude-3-5-sonnet-latest

# --- Ollama (local, private AI) ---------------------------------------------
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_CHAT_MODEL=llama3.1
OLLAMA_EMBEDDING_MODEL=nomic-embed-text

# --- Celery ------------------------------------------------------------------
CELERY_BROKER_DB=1
CELERY_RESULT_DB=2
CELERY_TASK_TIME_LIMIT_SECONDS=600
CELERY_TASK_SOFT_TIME_LIMIT_SECONDS=540

# --- RAG ---------------------------------------------------------------------
RAG_VECTOR_STORE=pgvector          # pgvector | chroma
RAG_CHUNK_SIZE=800
RAG_CHUNK_OVERLAP=120
RAG_TOP_K=6
RAG_WORKING_MEMORY_TURNS=12
